---
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase';

const { data: productos } = await supabase
  .from('productos')
  .select('*')
  .order('created_at', { ascending: false });
---

<Layout title="Catálogo — Ecovilla">
  <main class="contenedor">
    <h1>Catálogo</h1>

    {productos && productos.length > 0 ? (
      <div class="grilla">
        {productos.map((producto) => (
          <article class="tarjeta">
            {producto.imagen_url && (
              <img src={producto.imagen_url} alt={producto.nombre} />
            )}
            <h2>{producto.nombre}</h2>
            <p class="descripcion">{producto.descripcion}</p>
            <p class="precio">${producto.precio}</p>

            <button
              class="btn-agregar"
              data-id={producto.id}
              data-nombre={producto.nombre}
              data-precio={producto.precio}
              data-vendedor={producto.vendedor_id}
            >
              Agregar al carrito
            </button>

            <button
              class="btn-chat"
              data-producto={producto.id}
              data-vendedor={producto.vendedor_id}
              data-nombre={producto.nombre}
            >
              💬 Chatear con el vendedor
            </button>
          </article>
        ))}
      </div>
    ) : (
      <p class="vacio">Todavía no hay productos publicados.</p>
    )}
  </main>
</Layout>

<script>
  import { supabase } from '../lib/supabase';

  // Agregar al carrito
  document.querySelectorAll('.btn-agregar').forEach((btn) => {
    btn.addEventListener('click', () => {
      const item = {
        id: btn.getAttribute('data-id'),
        nombre: btn.getAttribute('data-nombre'),
        precio: Number(btn.getAttribute('data-precio')),
        vendedor_id: btn.getAttribute('data-vendedor'),
        cantidad: 1,
      };

      const carrito = JSON.parse(localStorage.getItem('carrito') || '[]');
      const existente = carrito.find((p: any) => p.id === item.id);

      if (existente) {
        existente.cantidad += 1;
      } else {
        carrito.push(item);
      }

      localStorage.setItem('carrito', JSON.stringify(carrito));
      alert('Producto agregado al carrito');
    });
  });

  // Chatear con el vendedor
  document.querySelectorAll('.btn-chat').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const { data } = await supabase.auth.getUser();
      if (!data.user) {
        window.location.href = '/entrar';
        return;
      }

      const productoId = btn.getAttribute('data-producto');
      const vendedorId = btn.getAttribute('data-vendedor');

      if (!vendedorId) {
        alert('Este producto no tiene vendedor asignado.');
        return;
      }

      window.location.href = `/chat?vendedor=${vendedorId}&producto=${productoId}`;
    });
  });
</script>

<style>
  .contenedor { max-width: 1100px; margin: 3rem auto; padding: 0 1.5rem; }
  h1 { color: #1f7a4d; }
  .grilla {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1.5rem;
    margin-top: 2rem;
  }
  .tarjeta {
    background: #fff;
    border: 1px solid #e6e2d8;
    border-radius: 12px;
    padding: 1rem;
    display: flex;
    flex-direction: column;
  }
  .tarjeta img {
    width: 100%;
    height: 160px;
    object-fit: cover;
    border-radius: 8px;
    margin-bottom: 0.8rem;
  }
  .tarjeta h2 { font-size: 1.1rem; margin: 0 0 0.4rem; }
  .descripcion { color: #666; font-size: 0.9rem; flex: 1; }
  .precio { font-weight: 700; color: #1f7a4d; font-size: 1.1rem; }
  .btn-agregar {
    margin-top: 0.6rem;
    width: 100%;
    background: #1f7a4d;
    color: #fff;
    border: none;
    border-radius: 8px;
    padding: 0.6rem;
    font-size: 0.95rem;
    cursor: pointer;
  }
  .btn-chat {
    margin-top: 0.5rem;
    width: 100%;
    background: #fff;
    color: #1f7a4d;
    border: 2px solid #1f7a4d;
    border-radius: 8px;
    padding: 0.5rem;
    font-size: 0.95rem;
    cursor: pointer;
  }
  .vacio { color: #777; margin-top: 2rem; }
</style>
