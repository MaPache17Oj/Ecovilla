---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Entrar">
  <main class="contenedor">
    <h1>Entrar</h1>

    <form id="form-entrar" method="post">
      <label for="email">Correo</label>
      <input type="email" id="email" name="email" required />

      <label for="password">Contraseña</label>
      <input type="password" id="password" name="password" required />

      <button type="submit">Entrar</button>
    </form>

    <p id="mensaje"></p>

    <p>¿No tienes cuenta? <a href="/registro">Regístrate</a></p>
  </main>
</Layout>

<script>
  import { supabase } from '../lib/supabase';

  const form = document.getElementById('form-entrar') as HTMLFormElement;
  const mensaje = document.getElementById('mensaje') as HTMLParagraphElement;

  // Función que decide a dónde ir según el rol
  async function irSegunRol(userId: string) {
    const { data, error } = await supabase
      .from('perfiles')
      .select('rol')
      .eq('id', userId)
      .single();

    if (error) {
      console.error('Error leyendo el rol:', error);
      return '/panel-comprador';
    }

    return data?.rol === 'vendedor' ? '/panel-vendedor' : '/panel-comprador';
  }

  // Si ya hay sesión, redirigir sin pedir contraseña
  const { data: { session } } = await supabase.auth.getSession();
  if (session) {
    window.location.href = await irSegunRol(session.user.id);
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    mensaje.textContent = 'Entrando...';

    const email = (document.getElementById('email') as HTMLInputElement).value;
    const password = (document.getElementById('password') as HTMLInputElement).value;

    const { data, error } = await supabase.auth.signInWithPassword({ email, password });

    if (error) {
      mensaje.textContent = 'Error: ' + error.message;
      return;
    }

    mensaje.textContent = 'Sesión iniciada, redirigiendo...';
    window.location.href = await irSegunRol(data.user.id);
  });
</script>

<style>
  .contenedor {
    max-width: 420px;
    margin: 4rem auto;
    padding: 0 1.5rem;
  }

  h1 {
    margin-bottom: 1.5rem;
  }

  form {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  label {
    font-weight: 600;
    margin-top: 0.75rem;
  }

  input {
    padding: 0.6rem 0.8rem;
    border: 1px solid #ccc;
    border-radius: 6px;
    font-size: 1rem;
  }

  button {
    margin-top: 1.25rem;
    padding: 0.75rem;
    background: #1f7a4d;
    color: white;
    border: none;
    border-radius: 6px;
    font-size: 1rem;
    cursor: pointer;
  }

  button:hover {
    background: #17603c;
  }

  #mensaje {
    margin-top: 1rem;
    color: #b00020;
  }
</style>
