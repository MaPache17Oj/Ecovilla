---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Publicar producto">
  <main class="contenedor">
    <h1>Publicar producto</h1>
    <p class="subtitulo">Comparte lo que haces con la comunidad de Ecovilla.</p>

    <form id="form-producto" class="formulario">
      <label>
        Nombre del producto
        <input type="text" id="nombre" required />
      </label>

      <label>
        Descripción
        <textarea id="descripcion" rows="3" required></textarea>
      </label>

      <label>
        Precio (COP)
        <input type="number" id="precio" min="0" step="100" required />
      </label>

      <label>
        Artesano
        <input type="text" id="artesano" required />
      </label>

      <label>
        Foto del producto
        <input type="file" id="imagen" accept="image/jpeg,image/png" required />
      </label>

      <button type="submit">Publicar</button>
      <p id="aviso" class="aviso"></p>
    </form>
  </main>
</Layout>

<style>
  .contenedor {
    max-width: 640px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
  }

  h1 {
    color: #1f4d3a;
  }

  .subtitulo {
    color: #6b6b6b;
    margin-bottom: 2rem;
  }

  .formulario {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  label {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-weight: 600;
    color: #1f4d3a;
  }

  input,
  textarea {
    font: inherit;
    font-weight: 400;
    padding: 0.6rem 0.75rem;
    border: 1px solid #d8d2c4;
    border-radius: 8px;
    background: #fff;
  }

  button {
    font: inherit;
    font-weight: 600;
    padding: 0.75rem 1rem;
    border: none;
    border-radius: 8px;
    background: #1f4d3a;
    color: #fff;
    cursor: pointer;
  }

  button:hover {
    background: #17402f;
  }

  .aviso {
    margin: 0;
    font-weight: 600;
    color: #1f4d3a;
  }
</style>

<script>
  import { supabase } from '../lib/supabase';

  const formulario = document.getElementById('form-producto') as HTMLFormElement;
  const aviso = document.getElementById('aviso') as HTMLParagraphElement;

  formulario.addEventListener('submit', async (evento) => {
    evento.preventDefault();
    aviso.textContent = '';

    // 0. Comprobar sesión
    const { data: { session } } = await supabase.auth.getSession();
    if (!session) {
      window.location.href = '/entrar';
      return;
    }
    const usuario = session.user;

    // 1. Leer los campos
    const nombre = (document.getElementById('nombre') as HTMLInputElement).value.trim();
    const descripcion = (document.getElementById('descripcion') as HTMLTextAreaElement).value.trim();
    const precio = Number((document.getElementById('precio') as HTMLInputElement).value);
    const artesano = (document.getElementById('artesano') as HTMLInputElement).value.trim();
    const archivo = (document.getElementById('imagen') as HTMLInputElement).files?.[0];

    if (!archivo) {
      aviso.textContent = 'Selecciona una foto del producto.';
      return;
    }

    // 2. Subir la imagen al bucket
    const nombreArchivo = `${crypto.randomUUID()}-${archivo.name}`;

    const { error: errorSubida } = await supabase.storage
      .from('productos')
      .upload(nombreArchivo, archivo, {
        cacheControl: '3600',
        upsert: false,
      });

    if (errorSubida) {
      aviso.textContent = 'No se pudo subir la imagen: ' + errorSubida.message;
      return;
    }

    // 3. Obtener la URL pública
    const urlPublica = supabase.storage
      .from('productos')
      .getPublicUrl(nombreArchivo).data.publicUrl;

    // 4. Insertar el producto con la URL (nunca el objeto File)
    const { error: errorInsert } = await supabase
      .from('productos')
      .insert({
        nombre,
        descripcion,
        precio,
        imagen: urlPublica,
        artesano,
        vendedor_id: usuario.id,
        activo: true,
      });

    if (errorInsert) {
      aviso.textContent = 'No se pudo guardar: ' + errorInsert.message;
      return;
    }

    aviso.textContent = '¡Producto publicado!';
    formulario.reset();
  });
</script>
